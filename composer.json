{
    "name": "folklore/laravel-locale",
    "description": "Localization package for Laravel 8/9",
    "keywords": [
        "framework",
        "laravel",
        "localization",
        "locale",
        "translation"
    ],
    "authors": [
        {
            "name": "Folklore",
            "email": "info@atelierfolklore.ca",
            "homepage": "http://atelierfolklore.ca"
        },
        {
            "name": "David Mongeau-Petitpas",
            "email": "dmp@atelierfolklore.ca",
            "homepage": "http://mongo.ca",
            "role": "Developer"
        }
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^7.3|^8.0.2",
        "illuminate/support": "8.*|9.*|10.*|11.*|12.*|13.*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5.62|^11.5.50|^12.5.8",
        "laravel/pint": "^1.13",
        "larastan/larastan": "^2.9|^3.0"
    },
    "autoload": {
        "psr-0": {
            "Folklore\\Locale\\": "src/"
        },
        "files": [
            "src/Folklore/Locale/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Folklore\\Locale\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Folklore\\Locale\\LocaleServiceProvider"
            ]
        }
    }
}
